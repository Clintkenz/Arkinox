# GEMINI_API_KEY: Required for Gemini AI image generation.
# This is consumed ONLY by the server-side Netlify function
# (netlify/functions/generate-blog-image.ts) and must be set as a
# site environment variable in the Netlify dashboard (Site settings ->
# Environment variables), NOT baked into the client build. It is never
# read by client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
